[Unit]
Description=shortcode-locker: tiny 3-character shortcut/string resolver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shortcode-locker
Group=shortcode-locker
WorkingDirectory=/opt/shortcode-locker
Environment=HOST=0.0.0.0
Environment=PORT=8765
Environment=SHORTCODE_LOCKER_DATA=/var/lib/shortcode-locker/codes.json
EnvironmentFile=-/etc/shortcode-locker.env
ExecStart=/opt/shortcode-locker/.venv/bin/shortcode-locker serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/shortcode-locker

[Install]
WantedBy=multi-user.target
